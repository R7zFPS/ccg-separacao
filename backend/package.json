{
  "name": "separacao-estoque-backend",
  "version": "1.0.0",
  "description": "Backend do App de Demanda de Separação de Estoque — Casa das Correntes Guanabara",
  "main": "src/index.js",
  "scripts": {
    "dev": "nodemon src/index.js",
    "start": "node src/database/migrations.js && node src/database/seeds.js && node src/index.js",
