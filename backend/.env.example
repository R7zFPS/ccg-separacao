# =====================================================
# VARIÁVEIS DE AMBIENTE — BACKEND
# Copie este arquivo para .env e preencha os valores
# =====================================================

# Servidor
PORT=3001
NODE_ENV=development

# JWT
JWT_SECRET=sua_chave_secreta_jwt_muito_segura_aqui
JWT_EXPIRES_IN=8h
JWT_REFRESH_SECRET=sua_chave_refresh_token_aqui
JWT_REFRESH_EXPIRES_IN=7d

# Banco de Dados (SQLite — MVP local)
DATABASE_PATH=./src/database/separacao.db

# Upload de arquivos
UPLOAD_DIR=./src/uploads
MAX_FILE_SIZE_PDF=10485760
MAX_FILE_SIZE_FOTO=5242880

# Frontend URL (para CORS)
# Em produção: URL do Vercel. Aceita múltiplas origens separadas por vírgula.
# Exemplo: FRONTEND_URL=https://ccg-separacao.vercel.app,https://ccg-separacao-git-main.vercel.app
FRONTEND_URL=http://localhost:5173

# Cloudinary — armazenamento de arquivos em produção
# Obtenha em: https://cloudinary.com → Dashboard → API Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Escalada automática (em minutos) — reservado para uso futuro
TEMPO_ESCALADA_MINUTOS=30

# Rate limiting — em produção, NODE_ENV=production ativa os limiters
# Auth: 20 req / 15min por IP
# API geral: 200 req / 1min por IP
# (Em development o rate limit é desabilitado automaticamente)

# (Futuro) Supabase
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_KEY=

# (Futuro) Google Maps
# GOOGLE_MAPS_API_KEY=
