# =====================================================
# VARIÁVEIS DE AMBIENTE — FRONTEND (PRODUÇÃO)
# ⚠️  EDITE antes de rodar: npm run build
#
# Troque SEU_IP pelo IP do computador servidor.
# Ex: VITE_API_URL=http://192.168.1.10:3001
#
# Descubra o IP:
#   Windows: abra o CMD e digite: ipconfig
#   Mac:     abra o Terminal e digite: ifconfig | grep 192
# =====================================================

VITE_API_URL=http://SEU_IP_DO_SERVIDOR:3001
